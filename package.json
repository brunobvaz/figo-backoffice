{
  "name": "figo-backoffice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cloudflare": "vite build --mode cloudflare",
    "preview": "vite preview",
    "preview:cloudflare": "npm run build:cloudflare && wrangler dev --ip 127.0.0.1 --port 8787 --local-protocol https",
    "deploy": "npm run build:cloudflare && wrangler deploy",
    "deploy:check": "npm run build:cloudflare && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test:worker": "node --test tests/worker.test.js",
    "test:e2e": "playwright test",
    "test:e2e:cloudflare": "npm run build:cloudflare && E2E_CLOUDFLARE=1 playwright test",
    "format": "prettier --write src worker tests *.js *.json *.jsonc index.html *.md"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.7",
    "vite": "^7.3.0",
    "wrangler": "4.134.0"
  }
}
